{
  "manifest_version": 3,
  "name": "书签桥",
  "short_name": "书签桥",
  "description": "在 Chrome 与 Edge 配置文件之间，用本地加密同步码安全传递、预览和合并书签。",
  "version": "0.4.8",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/lglglglglg/chrome-bookmark-bridge",
  "action": {
    "default_title": "书签桥",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "file-import.html"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "bookmarks",
    "clipboardWrite",
    "sidePanel"
  ]
}
